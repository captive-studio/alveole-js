{
  "name": "@alveole/theme",
  "version": "2.0.0-alpha.19",
  "description": "Shared theme tokens and utilities.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "lint": "eslint . --cache --cache-strategy content",
    "test:unit": "jest --coverage --runInBand --ci",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../eslint-config",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "peerDependencies": {
    "@tamagui/core": "^3.0.0",
    "expo-font": "*",
    "expo-system-ui": "*",
    "react": "*",
    "react-native": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2"
  }
}
