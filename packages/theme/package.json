{
  "name": "@alveole/theme",
  "version": "1.10.0",
  "description": "Shared theme tokens and utilities.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "lint": "eslint . --cache --cache-strategy content",
    "test:unit": "jest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../eslint-config",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "peerDependencies": {
    "@tamagui/core": "*",
    "expo-font": "*",
    "expo-system-ui": "*",
    "react": "*",
    "react-native": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2"
  }
}
