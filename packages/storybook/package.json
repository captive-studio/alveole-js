{
  "name": "@alveole/storybook",
  "version": "2.0.0-alpha.18",
  "description": "Catalog screens and helpers for Alveole stories and theme tokens.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run generate:sources && tsc -p tsconfig.build.json",
    "generate:sources": "node ../components/scripts/generate-stories-sources.mjs",
    "lint": "pnpm run generate:sources && eslint . --cache --cache-strategy content",
    "typecheck": "pnpm run generate:sources && tsc -p tsconfig.typecheck.json --noEmit",
    "test:unit": "pnpm run generate:sources && npx jest --coverage --maxWorkers=$(node ../../scripts/print-allocated-cpus.mjs) --ci"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../eslint-config",
    "@testing-library/react": "16.3.3",
    "babel-preset-expo": "58.0.20",
    "eslint": "10.13.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "30.5.2",
    "jest-expo": "58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "0.21.4",
    "tamagui": "3.1.3"
  },
  "peerDependencies": {
    "@alveole/components": "*",
    "@alveole/core": "*",
    "@alveole/theme": "*",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "^15.0.0"
  }
}
