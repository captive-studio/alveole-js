{
  "name": "@alveole/core",
  "version": "1.10.0",
  "description": "Core for Alveole.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --cache --cache-strategy content",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test:unit": "NODE_OPTIONS=--max-old-space-size=4096 npx jest --coverage --maxWorkers=2 --ci"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../eslint-config",
    "date-fns": "4.4.0",
    "eslint": "9.39.5"
  },
  "peerDependencies": {
    "date-fns": "*"
  }
}
