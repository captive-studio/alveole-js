{
  "name": "@alveole/components",
  "version": "2.0.0-alpha.16",
  "description": "Shared UI components.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stories": {
      "types": "./dist/stories/index.d.ts",
      "default": "./dist/stories/index.js"
    },
    "./package.json": "./package.json",
    "./sync-pdfjs-web-assets": "./dist/scripts/sync-pdfjs-web-assets.mjs"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "scripts/postinstall.mjs",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run generate:sources && node ./scripts/generate-version.mjs && tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs && node ./scripts/prepare-pdfjs-web-assets.mjs",
    "lint": "pnpm run generate:sources && eslint . --cache --cache-strategy content",
    "postinstall": "node ./scripts/postinstall.mjs",
    "pretest:unit": "node --test scripts/generate-stories-sources.test.mjs",
    "test:unit": "NODE_OPTIONS=--max-old-space-size=4096 npx jest --coverage --maxWorkers=$(node ../../scripts/print-allocated-cpus.mjs) --ci",
    "test:dev": "NODE_OPTIONS=--max-old-space-size=4096 jest --maxWorkers=$(node ../../scripts/print-allocated-cpus.mjs) --coverage=false",
    "typecheck": "pnpm run generate:sources && tsc -p tsconfig.typecheck.json --noEmit",
    "generate:sources": "node scripts/generate-stories-sources.mjs",
    "doctor:fix": "npx expo install --check"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../eslint-config",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native/jest-preset": "0.88.0",
    "@shopify/flash-list": "2.3.2",
    "@tamagui/core": "3.1.3",
    "@tamagui/toast": "3.1.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-native": "14.1.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "babel-preset-expo": "58.0.20",
    "eslint": "10.13.0",
    "expo": "58.0.19",
    "expo-application": "58.1.2",
    "expo-asset": "58.0.18",
    "expo-document-picker": "58.0.4",
    "expo-image-picker": "58.0.10",
    "expo-in-app-updates": "0.13.0",
    "expo-linear-gradient": "58.0.3",
    "expo-modules-core": "58.0.26",
    "expo-router": "58.0.26",
    "expo-system-ui": "58.0.6",
    "expo-web-browser": "58.0.6",
    "jest": "29.7.0",
    "jest-environment-jsdom": "30.5.2",
    "jest-expo": "58.0.12",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-otp-entry": "1.8.6",
    "react-native-web": "0.21.4",
    "react-select": "5.10.2",
    "react-syntax-highlighter": "16.1.2",
    "tamagui": "3.1.3",
    "test-renderer": "1.3.1"
  },
  "dependencies": {
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@alveole/core": "*",
    "@alveole/theme": "*",
    "@lottiefiles/dotlottie-react": "*",
    "@react-native-community/datetimepicker": "*",
    "@shopify/flash-list": ">=2",
    "@tamagui/accordion": "^3.0.0",
    "@tamagui/animations-css": "^3.0.0",
    "@tamagui/avatar": "^3.0.0",
    "@tamagui/config": "^3.0.0",
    "@tamagui/core": "^3.0.0",
    "@tamagui/dialog": "^3.0.0",
    "@tamagui/popover": "^3.0.0",
    "@tamagui/radio-group": "^3.0.0",
    "@tamagui/sheet": "^3.0.0",
    "@tamagui/slider": "^3.0.0",
    "@tamagui/switch": "^3.0.0",
    "@tamagui/tabs": "^3.0.0",
    "@tamagui/toast": "^3.0.0",
    "@uiw/react-signature": "*",
    "date-fns": "*",
    "expo-application": "*",
    "expo-asset": "*",
    "expo-constants": "*",
    "expo-document-picker": "*",
    "expo-image": "*",
    "expo-image-picker": "*",
    "expo-in-app-updates": "*",
    "expo-linear-gradient": "*",
    "expo-router": "*",
    "expo-web-browser": "*",
    "lottie-react-native": "*",
    "pdfjs-dist": "^4.0.0 || ^5.0.0 || ^6.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-keyboard-controller": ">=1.21.0",
    "react-native-otp-entry": "*",
    "react-native-safe-area-context": "*",
    "react-native-signature-canvas": "*",
    "react-native-svg": "^15.0.0",
    "react-native-webview": ">=13",
    "react-select": ">=5",
    "react-syntax-highlighter": "*",
    "tamagui": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
