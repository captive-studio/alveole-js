{
  "name": "@alveole/components",
  "version": "1.9.0",
  "description": "Shared UI components.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stories": {
      "types": "./dist/stories/index.d.ts",
      "default": "./dist/stories/index.js"
    },
    "./package.json": "./package.json",
    "./sync-pdfjs-web-assets": "./dist/scripts/sync-pdfjs-web-assets.mjs"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run generate:sources && node ./scripts/generate-version.mjs && tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs && node ./scripts/prepare-pdfjs-web-assets.mjs",
    "lint": "npm run generate:sources && eslint .",
    "postinstall": "node ./scripts/postinstall.mjs",
    "test:unit": "NODE_OPTIONS=--max-old-space-size=4096 npx jest --maxWorkers=2 --ci",
    "typecheck": "npm run generate:sources && tsc -p tsconfig.typecheck.json --noEmit",
    "generate:sources": "node scripts/generate-stories-sources.mjs",
    "doctor:fix": "npx expo install --check"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../eslint-config",
    "@lucide/lab": "0.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-native/jest-preset": "0.86.3",
    "@shopify/flash-list": "2.0.2",
    "@tamagui/config": "1.144.4",
    "@tamagui/core": "1.144.4",
    "@tamagui/toast": "1.144.4",
    "@testing-library/react-native": "14.0.1",
    "@types/react-syntax-highlighter": "15.5.13",
    "babel-preset-expo": "57.0.10",
    "eslint": "9.39.5",
    "expo": "57.0.21",
    "expo-application": "57.0.2",
    "expo-asset": "57.0.16",
    "expo-document-picker": "57.0.1",
    "expo-in-app-updates": "0.12.0",
    "expo-modules-core": "57.0.17",
    "expo-router": "57.0.20",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "lucide-react-native": "1.31.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-code-highlighter": "1.3.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-otp-entry": "1.8.6",
    "react-select": "5.10.2",
    "react-syntax-highlighter": "16.1.1",
    "tamagui": "1.144.4",
    "test-renderer": "1.2.0"
  },
  "dependencies": {
    "react-markdown": "8.0.7",
    "remark-gfm": "3.0.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@alveole/core": "*",
    "@alveole/theme": "*",
    "@lottiefiles/dotlottie-react": "*",
    "@lucide/lab": "*",
    "@react-native-community/datetimepicker": "*",
    "@react-native-picker/picker": ">=2",
    "@shopify/flash-list": ">=2",
    "@tamagui/accordion": "^1.129.0 <2.0.0",
    "@tamagui/animations-css": "^1.129.0 <2.0.0",
    "@tamagui/avatar": "^1.129.0 <2.0.0",
    "@tamagui/config": "^1.129.0 <2.0.0",
    "@tamagui/core": "^1.129.0 <2.0.0",
    "@tamagui/dialog": "^1.129.0 <2.0.0",
