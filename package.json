{
  "name": "@alveole/root",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "postinstall": "node scripts/link-workspace-packages.mjs",
    "build:packages": "pnpm --filter @alveole/core --filter @alveole/theme --filter @alveole/components --filter @alveole/storybook run build",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:dev": "pnpm --filter @alveole/components run test:dev --",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "start:ui-kit": "pnpm --filter @alveole/docs run start --",
    "start:ui-kit:clear": "pnpm run start:ui-kit -- --clear",
    "doctor": "pnpm --filter @alveole/docs run doctor",
    "doctor:fix": "pnpm --filter @alveole/docs run doctor:fix && pnpm --filter @alveole/components run doctor:fix",
    "check:dead-code": "pnpm --filter @alveole/components run generate:sources && knip",
    "check:duplication": "jscpd",
    "check:lint-docs": "pnpm run build:packages && pnpm --filter @alveole/docs run lint:app",
    "check:packages": "scripts/check-packages",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "publish:local": "scripts/publish-local",
    "publish:package": "scripts/publish-package",
    "check": "node scripts/check.mjs",
    "test:scripts": "node --test scripts/allocated-cpus.test.mjs scripts/check.test.mjs scripts/check-suppressions.test.mjs scripts/compact-icons.test.mjs scripts/spacing-deprecie.test.mjs",
    "pretest:unit": "pnpm run test:scripts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "jest": "29.7.0",
    "jscpd": "5.2.1",
    "knip": "6.36.0",
    "prettier": "3.9.7",
    "prettier-plugin-organize-imports": "4.3.0",
    "publint": "0.3.24",
    "typescript": "6.0.3"
  }
}
