{
  "name": "@alveole/root",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "npm run --workspaces --if-present test:unit",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "start:ui-kit": "npm run start --workspace=apps/docs -- --clear",
    "doctor": "npm run doctor --workspace=apps/docs",
    "doctor:fix": "npm run doctor:fix --workspace=apps/docs && npm run doctor:fix --workspace=packages/components",
    "check:dead-code": "npm run generate:sources --workspace=packages/components && knip",
    "check:duplication": "jscpd",
    "check:lint-docs": "npm run build --workspace=packages/core --workspace=packages/theme --workspace=packages/components --workspace=packages/storybook && npm run lint:app --workspace=apps/docs",
    "check:packages": "scripts/check-packages",
    "publish:local": "scripts/publish-local",
    "publish:package": "scripts/publish-package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "jest": "29.7.0",
    "jscpd": "5.2.1",
    "knip": "6.35.1",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "publint": "0.3.24",
    "typescript": "6.0.3"
  }
}
