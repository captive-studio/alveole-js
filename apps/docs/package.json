{
  "name": "@alveole/docs",
  "private": true,
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ./scripts/sync-pdfjs-web-assets.mjs && ALVEOLE_LIVE=1 expo start --web",
    "build": "node ./scripts/sync-pdfjs-web-assets.mjs && node ./scripts/generate-sitemap.mjs && expo export --platform web",
    "lint:app": "eslint . --cache --cache-strategy content",
    "typecheck": "npm run generate:sources --prefix ../../packages/components && tsc -p tsconfig.typecheck.json --noEmit",
    "test:a11y": "playwright test",
    "test:a11y:baseline": "node scripts/generate-a11y-baseline.mts",
    "doctor": "expo-doctor",
    "doctor:fix": "npx expo install --check"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-router"
      ]
    }
  },
  "dependencies": {
    "@alveole/components": "*",
    "@alveole/core": "*",
    "@alveole/storybook": "*",
    "@alveole/theme": "*",
    "@lottiefiles/dotlottie-react": "0.19.16",
    "@tamagui/animations-css": "1.144.4",
    "@tamagui/config": "1.144.4",
    "@tamagui/core": "1.144.4",
    "@uiw/react-signature": "1.3.5",
    "expo": "57.0.22",
    "expo-application": "57.0.3",
    "expo-constants": "57.0.18",
    "expo-font": "57.0.4",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.10",
    "expo-router": "57.0.21",
    "expo-system-ui": "57.0.4",
    "lottie-react-native": "7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-signature-canvas": "5.1.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "tamagui": "1.144.4"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../../packages/eslint-config",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tamagui/babel-plugin": "1.144.4",
    "@types/node": "24.13.4",
    "@types/react": "19.2.17",
    "axe-core": "4.13.0",
    "babel-preset-expo": "57.0.11",
    "eslint": "9.39.5",
    "expo-doctor": "1.20.4",
    "serve": "14.2.6",
    "typescript": "6.0.3"
  }
}
