{
  "name": "@alveole/docs",
  "private": true,
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-post-install": "pnpm --dir ../.. run build:packages",
    "start": "pnpm --filter @alveole/storybook run generate:sources && node ./scripts/sync-pdfjs-web-assets.mjs && ALVEOLE_LIVE=1 expo start --web",
    "build": "node ./scripts/sync-pdfjs-web-assets.mjs && node ./scripts/generate-sitemap.mjs && expo export --platform web",
    "lint:app": "eslint . --cache --cache-strategy content",
    "typecheck": "pnpm --filter @alveole/components --filter @alveole/storybook run generate:sources && tsc -p tsconfig.typecheck.json --noEmit",
    "test:a11y": "playwright test",
    "test:e2e:local": "pnpm --dir ../.. run build:packages && DOCS_OUTPUT=single pnpm run build && playwright test",
    "test:a11y:baseline": "node scripts/generate-a11y-baseline.mts",
    "doctor": "expo-doctor",
    "doctor:fix": "npx expo install --check"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-router"
      ]
    }
  },
  "dependencies": {
    "@alveole/components": "*",
    "@alveole/core": "*",
    "@alveole/storybook": "*",
    "@alveole/theme": "*",
    "@lottiefiles/dotlottie-react": "0.20.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native/assets-registry": "0.88.0",
    "@shopify/flash-list": "2.3.2",
    "@tamagui/animations-css": "3.1.4",
    "@tamagui/config": "3.1.4",
    "@tamagui/core": "3.1.4",
    "@uiw/react-signature": "1.3.5",
    "expo": "58.0.19",
    "expo-application": "58.1.2",
    "expo-asset": "58.0.19",
    "expo-constants": "58.0.14",
    "expo-document-picker": "58.0.4",
    "expo-font": "58.0.11",
    "expo-image": "58.0.18",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.26",
    "expo-system-ui": "58.0.7",
    "expo-web-browser": "58.0.7",
    "lottie-react-native": "7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-signature-canvas": "5.1.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tamagui": "3.1.4"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../../packages/eslint-config",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "axe-core": "4.14.0",
    "babel-preset-expo": "58.0.20",
    "eslint": "10.13.0",
    "expo-doctor": "1.21.5",
    "serve": "14.2.6",
    "typescript": "6.0.3"
  }
}
