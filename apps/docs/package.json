{
  "name": "@alveole/docs",
  "private": true,
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "pnpm --filter @alveole/storybook run generate:sources && node ./scripts/sync-pdfjs-web-assets.mjs && ALVEOLE_LIVE=1 expo start --web",
    "build": "node ./scripts/sync-pdfjs-web-assets.mjs && node ./scripts/generate-sitemap.mjs && expo export --platform web",
    "lint:app": "eslint . --cache --cache-strategy content",
    "typecheck": "pnpm --filter @alveole/components --filter @alveole/storybook run generate:sources && tsc -p tsconfig.typecheck.json --noEmit",
    "test:a11y": "playwright test",
    "test:a11y:baseline": "node scripts/generate-a11y-baseline.mts",
    "doctor": "expo-doctor",
    "doctor:fix": "npx expo install --check"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-router"
      ]
    }
  },
  "dependencies": {
    "@alveole/components": "*",
    "@alveole/core": "*",
    "@alveole/storybook": "*",
    "@alveole/theme": "*",
    "@lottiefiles/dotlottie-react": "0.20.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/flash-list": "2.0.2",
    "@tamagui/animations-css": "2.7.7",
    "@tamagui/config": "2.7.7",
    "@tamagui/core": "2.7.7",
    "@uiw/react-signature": "1.3.5",
    "expo": "57.0.30",
    "expo-application": "57.0.3",
    "expo-asset": "57.0.20",
    "expo-constants": "57.0.22",
    "expo-document-picker": "57.0.3",
    "expo-image-picker": "57.0.20",
    "expo-font": "57.0.4",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.28",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "lottie-react-native": "7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-signature-canvas": "5.1.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tamagui": "2.7.7"
  },
  "devDependencies": {
    "@alveole/eslint-config": "file:../../packages/eslint-config",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "axe-core": "4.14.0",
    "babel-preset-expo": "57.0.16",
    "eslint": "10.13.0",
    "expo-doctor": "1.21.4",
    "serve": "14.2.6",
    "typescript": "6.0.3"
  }
}
