# node_modules est un arbre de liens durs vers le store, jamais une copie. C'est la
# raison d'être de cette migration : sur les runners, npm recopiait 1,1 Go et 105 413
# fichiers à chaque job, cinq fois par run, et ces écritures de petits fichiers
# saturaient le NVMe partagé par toute la CI de l'organisation.
#
# `hardlink` explicitement, et non `auto` : `auto` retombe silencieusement en copie
# quand le store et node_modules ne sont pas sur le même système de fichiers, ce qui
# annulerait tout le bénéfice sans le moindre message. Épinglé, l'échec devient visible.
package-import-method=hardlink

# Les paquets du monorepo se référencent entre eux en `"*"` et en `file:`. Depuis
# pnpm 10 le défaut est `false`, ce qui enverrait chercher @alveole/core sur le
# registre au lieu du workspace voisin.
link-workspace-packages=true

# Arbre a plat, comme npm : les dependances fantomes continuent de se resoudre.
# Les liens durs vers le store sont conserves, donc le gain en ecriture aussi.
node-linker=hoisted
